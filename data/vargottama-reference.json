{
  "schemaVersion": 1,
  "title": "คลังอ้างอิงวรโคตมะและนวางศ์พิเศษ",
  "usage": "ข้อมูลอ้างอิงสำหรับวิเคราะห์ตำแหน่งดาวจากองศาจริง ไม่ใช่สูตรคำนวณดวงหลัก",
  "rules": {
    "navamsaVargottama": {
      "movable": "0°00′–3°20′",
      "fixed": "13°20′–16°40′",
      "dual": "26°40′–30°00′",
      "method": "นวางศ์แรกของจรราศี นวางศ์กลางของสถิรราศี นวางศ์สุดท้ายของทวิภาวะราศี"
    },
    "special": [
      "สวะกษัตระ/เกษตรวรโคตมะ",
      "อุจจะวรโคตมะ",
      "นิจวรโคตมะ"
    ],
    "vargottamaNakshatra": [
      {
        "name": "ปุนรวสุ",
        "padas": [
          3,
          4
        ]
      },
      {
        "name": "จิตรา",
        "padas": [
          2,
          3
        ]
      },
      {
        "name": "อุตตราษาฒ",
        "padas": [
          1,
          2
        ]
      }
    ],
    "sixStrengthPrinciples": [
      "วรโคตมะ",
      "ดาวเคราะห์เป็นอุจจ์",
      "ดาวเคราะห์อยู่ราศีมูลตรีโกณหรือเกษตร",
      "ดาวเคราะห์สถิตในเรือนเกณฑ์",
      "เจ้าเรือนของราศีที่ดาวสถิตอยู่เข้มแข็ง",
      "ดาวเคราะห์ประกอบเป็นรูปโยค เช่น ราชาโยค"
    ],
    "ashtakavargaNote": "เอกสารต้นทางระบุสมุทยะอัษฏกวรรค 30 bindus ขึ้นไปเป็นเงื่อนไขที่ให้ผลเด่น ควรถือเป็นข้ออ้างอิงตามเอกสาร ไม่ใช่สูตรสากล"
  },
